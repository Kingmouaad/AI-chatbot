# Where the FastAPI backend lives. Optional locally (defaults to http://localhost:8000); set it when the API is deployed.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Better Auth (server only: never prefix these with NEXT_PUBLIC_) ---
# Same Neon database as the API, but with the plain postgresql:// prefix (node-postgres, not psycopg)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=verify-full
# any long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional. Without them the "Continue with Google" button shows an error and email sign-in still works.
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application),
# authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
