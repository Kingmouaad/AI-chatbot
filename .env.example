# Neon connection string. Two rules (see README "Database"):
#   - prefix must be postgresql+psycopg:// (not postgresql://), the app uses psycopg 3
#   - use the direct host: delete "-pooler" from the hostname Neon's dashboard gives you
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
CORS_ORIGINS=http://localhost:3000
